  header: "\u05DE\u05D4 \u05DB\u05D3\u05D0\u05D9 \u05DC\u05E2\u05E9\u05D5\u05EA \u05E2\u05DB\u05E9\u05D9\u05D5"
  titleCreateTank: "\u05D1\u05E0\u05D4 \u05D8\u05E0\u05E7"
  titleChangeStance: "\u05E9\u05E0\u05D4 \u05EA\u05E4\u05E7\u05D9\u05D3"
  titleEvolve: "\u05E9\u05D3\u05E8\u05D2 \u05D8\u05E0\u05E7"
  titleBunker: "\u05D1\u05E0\u05D4 \u05D1\u05D5\u05E0\u05E7\u05E8"
  titleCrystal: "\u05D1\u05E0\u05D4 \u05D2\u05D1\u05D9\u05E9"
  titleCommand: "\u05D1\u05E0\u05D4 \u05DE\u05E8\u05DB\u05D6 \u05E4\u05D9\u05E7\u05D5\u05D3"
  titleBuild: "\u05D1\u05E0\u05D4"
  reasons:
  - "\u05D4\u05DE\u05D2\u05DF \u05E9\u05DC \u05D4\u05E9\u05E2\u05E8 \u05E0\u05E9\u05D1\u05E8
    \xB7 \u05D6\u05D4 \u05D4\u05D6\u05DE\u05DF \u05DC\u05E1\u05D2\u05D5\u05E8 \u05D0\u05D5\u05EA\u05D5"
  - "\u05D4\u05E9\u05E2\u05E8 \u05D4\u05D6\u05D4 \u05E2\u05DC \u05E1\u05E3 \u05E0\u05E4\u05D9\u05DC\u05D4
    \xB7 \u05DE\u05DB\u05D4 \u05D0\u05D7\u05EA \u05EA\u05E1\u05E4\u05D9\u05E7"
  - "\u05D0\u05D5\u05D9\u05D1\u05D9\u05DD \u05DE\u05EA\u05E7\u05E8\u05D1\u05D9\u05DD
    \u05DC\u05D1\u05E1\u05D9\u05E1 \xB7 \u05D8\u05E0\u05E7 \u05E9\u05DE\u05D9\u05E8\u05D4
    \u05D0\u05D5 \u05D1\u05D5\u05E0\u05E7\u05E8 \u05D9\u05E2\u05E6\u05E8\u05D5 \u05D0\u05D5\u05EA\u05DD,
    \u05D5\u05DB\u05DC \u05D0\u05D5\u05D9\u05D1 \u05E9\u05E0\u05D5\u05E4\u05DC \u05DE\u05E1\u05D3\u05E7
    \u05D0\u05EA \u05D4\u05E9\u05E2\u05E8 \u05E9\u05DC\u05D5"
  - "\u05D2\u05DC \u05DE\u05EA\u05E7\u05E8\u05D1 \xB7 \u05D7\u05D6\u05E7 \u05D0\u05EA
    \u05D4\u05E7\u05D5 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D9\u05D2\u05D9\u05E2"
  - "\u05D9\u05E9 \u05D2\u05D1\u05D9\u05E9 \u05DC\u05D9\u05D3 \u05D4\u05D8\u05E0\u05E7
    \u05D4\u05D6\u05D4 \xB7 \u05E9\u05D3\u05E8\u05D5\u05D2 \u05DE\u05DB\u05E4\u05D9\u05DC
    \u05D0\u05EA \u05D4\u05E0\u05D6\u05E7 \u05E9\u05DC\u05D5"
  - "\u05D4\u05D4\u05DB\u05E0\u05E1\u05D4 \u05E9\u05DC\u05DA \u05E0\u05DE\u05D5\u05DB\u05D4
    \u05DE\u05D3\u05D9 \xB7 \u05D1\u05E0\u05D4 \u05D0\u05D5 \u05E9\u05D3\u05E8\u05D2
    \u05DE\u05EA\u05E7\u05DF \u05D2\u05D6 \xB7 \u05D1\u05DC\u05D9 \u05D0\u05E0\u05E8\u05D2\u05D9\u05D4
    \u05D0\u05D9\u05DF \u05DE\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA"
  - "\u05D0\u05E3 \u05D8\u05E0\u05E7 \u05DC\u05D0 \u05E6\u05D5\u05E2\u05D3 \u05D0\u05DC
    \u05D4\u05E9\u05E2\u05E8\u05D9\u05DD \xB7 \u05D1\u05DC\u05D9 \u05D6\u05D4 \u05D0\u05D9
    \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E0\u05E6\u05D7"
  - "\u05D4\u05E9\u05E2\u05E8 \u05D4\u05D6\u05D4 \u05DE\u05EA\u05D0\u05D5\u05E9\u05E9
    \xB7 \u05D4\u05E4\u05DC \u05D0\u05D5\u05D9\u05D1 \u05DE\u05E9\u05DC\u05D5 \u05D0\u05D5
    \u05E2\u05E0\u05D4 \u05E0\u05DB\u05D5\u05DF \u05DB\u05D3\u05D9 \u05DC\u05E9\u05DE\u05D5\u05E8
    \u05E2\u05DC \u05D4\u05E1\u05D3\u05E7\u05D9\u05DD"
  - "\u05D4\u05DE\u05D2\u05DF \u05E0\u05E9\u05D1\u05E8 \u05D0\u05D1\u05DC \u05D4\u05D8\u05E0\u05E7
    \u05E8\u05D7\u05D5\u05E7 \u05DE\u05D3\u05D9 \xB7 \u05D1\u05E0\u05D4 \u05DE\u05E8\u05DB\u05D6
    \u05E4\u05D9\u05E7\u05D5\u05D3 \u05D1\u05D3\u05E8\u05DA: \u05D8\u05E0\u05E7 \u05D1\u05E8\u05D3\u05D9\u05D5\u05E1
    \u05E9\u05DC\u05D5 \u05E6\u05D5\u05E2\u05D3 \u05DE\u05E9\u05D1\u05E6\u05EA \u05E0\u05D5\u05E1\u05E4\u05EA"
  stanceNames:
  - "\u05E9\u05DE\u05D9\u05E8\u05D4"
  - "\u05D4\u05E1\u05EA\u05E2\u05E8\u05D5\u05EA"
  - "\u05E6\u05D9\u05D3"
