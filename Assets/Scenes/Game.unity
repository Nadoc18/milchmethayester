  labelTankCreate: "\u05D1\u05E0\u05D9\u05D9\u05EA \u05D8\u05E0\u05E7"
  labelTankEvolve: "\u05E9\u05D3\u05E8\u05D5\u05D2 \u05D8\u05E0\u05E7"
  labelStanceChange: "\u05D0\u05E4\u05E9\u05E8\u05D5\u05D9\u05D5\u05EA \u05D4\u05D8\u05E0\u05E7"
  stanceNames:
