  changeSubtitle: "\u05D1\u05D7\u05E8 \u05EA\u05E4\u05E7\u05D9\u05D3 \u05D7\u05D3\u05E9
    \u05D0\u05D5 \u05E9\u05D3\u05E8\u05D2 \u05D0\u05EA \u05D4\u05D8\u05E0\u05E7"
  cancelLabel: "\u05D1\u05D9\u05D8\u05D5\u05DC"
  freeLabel: "\u05D7\u05D9\u05E0\u05DD"
  currentLabel: "\u05D4\u05EA\u05E4\u05E7\u05D9\u05D3 \u05D4\u05E0\u05D5\u05DB\u05D7\u05D9"
  evolveName: "\u05E9\u05D3\u05E8\u05D5\u05D2 \u05DC\u05E8\u05DE\u05D4 2"
  evolveBody: "\u05D3\u05E8\u05D2\u05D4 2: 60 \u05D7\u05D9\u05D9\u05DD, 20 \u05E0\u05D6\u05E7,
    \u05D8\u05D5\u05D5\u05D7 2 \u05D5\u05E9\u05EA\u05D9 \u05DE\u05E9\u05D1\u05E6\u05D5\u05EA
    \u05EA\u05E0\u05D5\u05E2\u05D4 \xB7 \u05D0\u05E4\u05E9\u05E8 \u05E8\u05E7 \u05D1\u05D8\u05D5\u05D5\u05D7
    \u05E9\u05DC \u05D2\u05D1\u05D9\u05E9"
  crystalOrderName: "\u05D4\u05EA\u05E7\u05E8\u05D1 \u05DC\u05D2\u05D1\u05D9\u05E9"
  crystalOrderBody: "\u05D4\u05D8\u05E0\u05E7 \u05E0\u05D5\u05E1\u05E2 \u05D0\u05DC
    \u05D4\u05D2\u05D1\u05D9\u05E9 \u05D4\u05E7\u05E8\u05D5\u05D1 \u05D5\u05E0\u05E9\u05D0\u05E8
    \u05DC\u05D9\u05D3\u05D5 \xB7 \u05E9\u05DD \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E9\u05D3\u05E8\u05D2
    \u05D0\u05D5\u05EA\u05D5 \u05DC\u05D3\u05E8\u05D2\u05D4 2"
  crystalOrderCurrent: "\u05D1\u05D3\u05E8\u05DA"
  stanceNames:
  - "\u05E9\u05DE\u05D9\u05E8\u05D4"
  - "\u05D4\u05E1\u05EA\u05E2\u05E8\u05D5\u05EA"
  - "\u05E6\u05D9\u05D3"
  stanceBodies:
  - "\u05E0\u05E9\u05D0\u05E8 \u05DC\u05D9\u05D3 \u05D4\u05D1\u05E1\u05D9\u05E1 \u2014
    \u05D0\u05D5 \u05DC\u05D9\u05D3 \u05DE\u05E8\u05DB\u05D6 \u05E4\u05D9\u05E7\u05D5\u05D3
    \u05E9\u05EA\u05D1\u05D7\u05E8 \u2014 \u05D5\u05EA\u05D5\u05E7\u05E3 \u05DB\u05DC
    \u05D0\u05D5\u05D9\u05D1 \u05E9\u05DE\u05EA\u05E7\u05E8\u05D1 \xB7 \u05DC\u05D0
    \u05D9\u05D5\u05E6\u05D0 \u05DC\u05E9\u05D3\u05D4"
  - "\u05E6\u05D5\u05E2\u05D3 \u05D0\u05DC \u05D4\u05E9\u05E2\u05E8\u05D9\u05DD \u05DB\u05D3\u05D9
    \u05DC\u05E1\u05D2\u05D5\u05E8 \u05D0\u05D5\u05EA\u05DD \xB7 \u05D0\u05D5\u05D9\u05D1
    \u05D1\u05D3\u05E8\u05DA \u05DC\u05D0 \u05DE\u05E1\u05D9\u05D8 \u05D0\u05D5\u05EA\u05D5
    \xB7 \u05D4\u05D3\u05E8\u05DA \u05D4\u05D9\u05D7\u05D9\u05D3\u05D4 \u05DC\u05E0\u05E6\u05D7"
  - "\u05E8\u05D5\u05D3\u05E3 \u05D0\u05D7\u05E8\u05D9 \u05D0\u05D5\u05D9\u05D1\u05D9\u05DD
    \u05D1\u05DB\u05DC \u05D4\u05DE\u05E4\u05D4 \xB7 \u05DC\u05D0 \u05E0\u05D5\u05D2\u05E2
    \u05D1\u05E9\u05E2\u05E8\u05D9\u05DD"
