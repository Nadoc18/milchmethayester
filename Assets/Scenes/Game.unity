  labelMountain: "\u05DE\u05E8\u05DB\u05D6 \u05E4\u05D9\u05E7\u05D5\u05D3"
  labelMaxLevel: "\u05D1\u05E8\u05DE\u05D4 \u05D4\u05DE\u05E8\u05D1\u05D9\u05EA"
  labelOccupied: "\u05EA\u05E4\u05D5\u05E1"
  labelFree: "\u05D7\u05D9\u05E0\u05DD"
  effectBunker: "\u05D9\u05D5\u05E8\u05D4 \u05DC\u05D1\u05D3 \u05E2\u05DC \u05DB\u05DC
    \u05D0\u05D5\u05D9\u05D1 \u05E9\u05DE\u05EA\u05E7\u05E8\u05D1, \u05D1\u05DC\u05D9
    \u05DC\u05E1\u05DB\u05DF \u05D8\u05E0\u05E7 \xB7 \u05D4\u05D9\u05E8\u05D9 \u05DC\u05D0
    \u05E2\u05D5\u05DC\u05D4 \u05D0\u05E0\u05E8\u05D2\u05D9\u05D4 \xB7 \u05E0\u05E9\u05D7\u05E7
    \u05E8\u05E7 \u05DB\u05E9\u05D4\u05D5\u05D0 \u05D9\u05D5\u05E8\u05D4: 4 \u05D7\u05D9\u05D9\u05DD
    \u05DC\u05DB\u05DC \u05D9\u05E8\u05D9\u05D9\u05D4 \xB7 \u05D1\u05DC\u05D9 \u05D0\u05D5\u05D9\u05D1\u05D9\u05DD
    \u05D1\u05D8\u05D5\u05D5\u05D7 \u05D4\u05D5\u05D0 \u05DC\u05D0 \u05E0\u05E9\u05D7\u05E7
    \u05DB\u05DC\u05DC"
  effectGas: "\u05D4\u05DE\u05EA\u05E7\u05DF \u05E9\u05DC\u05DA: \u05DB\u05DC \u05D4\u05D0\u05E0\u05E8\u05D2\u05D9\u05D4
    \u05E9\u05DC\u05DA \u05DE\u05D2\u05D9\u05E2\u05D4 \u05DE\u05DB\u05D0\u05DF \xB7
    \u05D4\u05D0\u05D5\u05D9\u05D1 \u05D9\u05D1\u05D5\u05D0 \u05DC\u05D4\u05E8\u05D5\u05E1
    \u05D0\u05D5\u05EA\u05D5 \xB7 \u05E9\u05DE\u05D5\u05E8 \u05E2\u05DC\u05D9\u05D5
    \xB7 \u05E9\u05D9\u05DD \u05DC\u05D1: \u05DB\u05DC 60 \u05D4\u05DB\u05E0\u05E1\u05D4
    \u05DE\u05DE\u05EA\u05E7\u05E0\u05D9\u05DD \u05DE\u05D6\u05E8\u05D6\u05EA \u05D0\u05EA
    \u05D4\u05E9\u05E2\u05E8\u05D9\u05DD \u05D1\u05EA\u05D5\u05E8 \u05D0\u05D7\u05D3"
  effectCrystal: "\u05DC\u05D0 \u05DE\u05D1\u05D9\u05D0 \u05D0\u05E0\u05E8\u05D2\u05D9\u05D4
    \xB7 \u05DE\u05E8\u05E4\u05D0 \u05D8\u05E0\u05E7\u05D9\u05DD \u05D1\u05D8\u05D5\u05D5\u05D7
    \u05E9\u05DC\u05D5 \u05D1\u05DB\u05DC \u05EA\u05D5\u05E8, \u05DE\u05D5\u05E1\u05D9\u05E3
    \u05DC\u05D4\u05DD 20 \u05D7\u05D9\u05D9\u05DD \xB7 \u05D5\u05E8\u05E7 \u05D1\u05D8\u05D5\u05D5\u05D7
    \u05E9\u05DC\u05D5 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E9\u05D3\u05E8\u05D2 \u05D8\u05E0\u05E7
    \u05DC\u05D3\u05E8\u05D2\u05D4 2"
  effectMountain: "\u05D1\u05D5\u05E2\u05D4 \u05DB\u05D7\u05D5\u05DC\u05D4 \u05E1\u05D1\u05D9\u05D1\u05D5:
    \u05D4\u05D0\u05D5\u05D9\u05D1 \u05DC\u05D0 \u05E0\u05DB\u05E0\u05E1 \xB7 \u05D4\u05D5\u05D0
    \u05E2\u05D5\u05E6\u05E8 \u05D1\u05E7\u05E6\u05D4 \u05D5\u05DE\u05DB\u05D4 \u05D1\u05D4
    \u05DE\u05D1\u05D7\u05D5\u05E5 \u05E2\u05D3 \u05E9\u05EA\u05D9\u05E9\u05D1\u05E8
    \xB7 \u05D1\u05EA\u05D5\u05E8 \u05E9\u05E7\u05D8 \u05D4\u05D1\u05D5\u05E2\u05D4
    \u05DE\u05EA\u05DE\u05DC\u05D0\u05EA \u05DE\u05D7\u05D3\u05E9 \xB7 \u05DB\u05DC
    \u05D8\u05E0\u05E7 \u05D1\u05E8\u05D3\u05D9\u05D5\u05E1 \u05D4\u05E4\u05D9\u05E7\u05D5\u05D3
    \u05E6\u05D5\u05E2\u05D3 \u05DE\u05E9\u05D1\u05E6\u05EA \u05E0\u05D5\u05E1\u05E4\u05EA,
    \u05D5\u05D8\u05E0\u05E7 \u05E9\u05DE\u05D9\u05E8\u05D4 \u05DE\u05D2\u05DF \u05DB\u05D0\u05DF
    \u05DB\u05DE\u05D5 \u05E2\u05DC \u05D4\u05D1\u05E1\u05D9\u05E1"
  effectTankCreate: "\u05D4\u05D9\u05D7\u05D9\u05D3\u05D4 \u05D4\u05D9\u05D7\u05D9\u05D3\u05D4
    \u05E9\u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05E1\u05D2\u05D5\u05E8 \u05E9\u05E2\u05E8
    \xB7 \u05D1\u05D7\u05E8 \u05DC\u05D5 \u05EA\u05E4\u05E7\u05D9\u05D3 \u05D1\u05D7\u05DC\u05D5\u05DF
    \u05E9\u05D9\u05D9\u05E4\u05EA\u05D7 \xB7 \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3
    \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05D7\u05D9\u05E0\u05DD, \u05E9\u05D9\u05E0\u05D5\u05D9
    \u05D0\u05D7\u05E8 \u05DB\u05DA \u05E2\u05D5\u05DC\u05D4 15"
  effectTankEvolve: "\u05D3\u05E8\u05D2\u05D4 2: \u05DB\u05E4\u05D5\u05DC \u05E0\u05D6\u05E7,
    \u05D8\u05D5\u05D5\u05D7 2 \u05D5\u05E9\u05EA\u05D9 \u05DE\u05E9\u05D1\u05E6\u05D5\u05EA
    \u05EA\u05E0\u05D5\u05E2\u05D4 \xB7 \u05D0\u05E4\u05E9\u05E8 \u05E8\u05E7 \u05D1\u05D8\u05D5\u05D5\u05D7
    \u05E9\u05DC \u05D2\u05D1\u05D9\u05E9"
